<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(VIRTUAL_GAME_DIR)</GameDir>
    <Managed>$(GameDir)\Virtual Succubus_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FacialIntent.cs" Link="FacialIntent.cs" />
    <Compile Include="../../src/AniFacialAdapter.cs" Link="AniFacialAdapter.cs" />
    <Compile Include="Program.cs" />
    <!-- Local test output needs these type definitions. All bin/obj outputs are
         ignored and excluded from the distribution archive. No engine API runs. -->
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Managed)\UnityEngine.CoreModule.dll')" Text="Supply -p:GameDir with your compatible local game installation; Unity assemblies are not distributed with these tests." />
  </Target>
</Project>
