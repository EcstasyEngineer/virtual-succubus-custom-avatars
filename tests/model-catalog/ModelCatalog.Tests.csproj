<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(VIRTUAL_GAME_DIR)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ModelCatalog.cs" Link="ModelCatalog.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="BepInEx"><HintPath>$(GameDir)/BepInEx/core/BepInEx.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)/BepInEx/core/BepInEx.dll')" Text="Set VIRTUAL_GAME_DIR or pass -p:GameDir for the local BepInEx installation. No loader binaries are supplied." />
  </Target>
</Project>
